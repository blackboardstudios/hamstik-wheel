# Hamstik Wheel repository configuration.
# Copy to .hamstik-wheel.toml and adjust for the repository.

[hamstik]
# Absolute or relative path to the Hamstik CLI binary.
# Defaults to "hamstik" (resolved via PATH) when omitted.
cli_path = "hamstik"

# Candidate discovery is scoped to the Organization/Project selected by Hamstik CLI.
# Epics are excluded by default because Wheel should execute actionable child work.
statuses = ["todo"]
item_types = ["task", "bug", "story", "feature"]
# Optional extra eligibility gate. Example: ["agent-ready"]
label_names = []

[models]
# Any model identifier/pattern Pi can resolve is valid. Prefer the full
# catalog id exactly as shown by `pi --list-models <pattern>`: a partial
# pattern that matches several models (including variant suffixes like
# OpenRouter's `:batch`) is resolved by Pi's fuzzy match, which can pick a
# different model than intended. A provider-qualified full id like
# "openrouter/z-ai/glm-5.3-flash" always resolves exactly.
implement = "step-3.7-flash"
review = "glm-5.3-flash"

# Optional additional toolchain directories. Linux Bubblewrap isolation is always on.
# The directory and its bin/ subdirectory are added to the isolated tool PATH.
[sandbox]
read_only_paths = []

[validation]
# Sandboxed by default, including agent-edited scripts. At least one base command
# is required. Every command must pass. No host network, sockets or credentials.
execution = "sandbox"
# Opting into execution = "trusted_host" gives edited tests/scripts full host
# access. Use ONLY inside an already disposable trusted VM/container, with
# disposable test resources. Never enable this just to bypass isolation failures.
commands = [
  "./scripts/do-prechecks.py",
]

# Require specialized rule coverage for critical paths (adapt to your repository).
# require_rules_for = ["drizzle/", "src/db/"]

# Optional specialized gates. Literal repository-relative prefixes, not globs.
# Every matched command must pass; rules are re-evaluated after review edits.
# [[validation.rules]]
# path_prefixes = ["drizzle/", "src/db/"]
# commands = ["pnpm migrations:test", "pnpm test:pg:ephemeral"]

[loop]
max_items = 10
max_review_cycles = 3
# "skip": record the failure, restore the item's baseline tree, and continue
# with the next Work Item. "halt": stop the run on the first failure (default).
# Provider outages preserve the active checkpoint and stop after bounded retries
# in either mode, so `resume` can continue the same phase.
on_failure = "halt"
# Wall-clock cap for each agent session, in minutes. 0 disables the cap.
agent_timeout_minutes = 105
# Retry the implementation session once when the first attempt fails to
# submit a valid wheel_result tool result.
implement_retry = false
# Additional sessions for transient provider errors (0 disables; maximum 10).
# Authentication failures stop immediately. Independent of implement_retry.
provider_retries = 3
# Initial retry delay; doubles each time, capped at 300 seconds.
provider_retry_delay_seconds = 30

[git]
require_clean_start = true
commit = true
commit_message = "{key}: {title}"

[comments]
post_started = true
post_completed = true
